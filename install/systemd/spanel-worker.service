[Unit]
Description=SPanel queued website provisioning worker
After=network.target mariadb.service nginx.service
Wants=mariadb.service nginx.service

[Service]
Type=oneshot
User=spanel
Group=www-data
WorkingDirectory=/opt/spanel
ExecStart=/usr/bin/php /opt/spanel/bin/worker.php
UMask=0077
PrivateTmp=true
ProtectHome=true
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
